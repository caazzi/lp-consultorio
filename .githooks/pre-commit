#!/usr/bin/env sh
#
# pre-commit — blocks a commit that introduces a secret.
#
# LOCAL layer (before the secret leaves the machine). Complements GitHub's Secret
# Scanning + Push Protection, which only act on push and miss generic/entropy
# patterns. Install with: npm run hooks:install
#
# Behaviour when gitleaks is NOT installed: warn and let it through (fail-open).
# CI (.github/workflows/gitleaks.yml) is the mandatory safety net; this hook is a
# convenience and must not block people who do not have the tool.

set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "⚠️  pre-commit: gitleaks not found — skipping the local scan."
  echo "    Install: https://github.com/gitleaks/gitleaks#installing"
  echo "    (CI keeps scanning; see .github/workflows/gitleaks.yml)"
  exit 0
fi

# `--staged` scans only what is about to be committed (fast).
# `--redact` avoids printing the secret value to the terminal/log.
if ! gitleaks protect --staged --redact --config .gitleaks.toml --verbose; then
  echo ""
  echo "❌ Commit blocked: a possible secret was detected in the staged files."
  echo "   Review the file(s) above. If it is a false positive, adjust the"
  echo "   allowlist in .gitleaks.toml (with a justification) or use:"
  echo "     git commit --no-verify"
  exit 1
fi

exit 0
