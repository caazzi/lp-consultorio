{
  "name": "lp-consultorio",
  "version": "1.0.0",
  "description": "High-performance medical landing page optimized for conversion and security. Built with Tailwind CSS and hosted on Netlify for Dr. Gilberto Salustiano and Dra. Anabel Lima.",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/assets/css/style.css --minify",
    "analyze": "node scripts/analyze-performance.js",
    "access-logs": "node scripts/fetch-access-insights.js",
    "ga-metrics": "node scripts/fetch-ga4-metrics.js",
    "ads-attribution": "node scripts/fetch-ads-attribution.js",
    "ads": "node ads/ads-cli.js",
    "ads-auth": "node ads/ads-cli.js auth",
    "ads-doctor": "node ads/ads-cli.js doctor",
    "ads-access": "node ads/ads-cli.js access",
    "ads-funnel": "node ads/ads-cli.js funnel",
    "ads-report": "node ads/ads-cli.js report",
    "ads-slices": "node ads/ads-cli.js slices",
    "ads-audit": "node ads/ads-cli.js audit-attribution",
    "ads-negatives": "node ads/ads-cli.js negatives",
    "ads-pause": "node ads/ads-cli.js pause-keywords",
    "ads-goals": "node ads/ads-cli.js goals",
    "ads-goals-fix": "node ads/ads-cli.js goals-fix",
    "perf": "node scripts/run-perf.js",
    "test": "node scripts/test-csp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caazzi/lp-consultorio.git"
